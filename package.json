{
  "name": "cipherkeep",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard": "node scripts/check-public-repo.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cd go && go run ./cmd/ck-server -data ../.dev-data -port 5174 -token dev-token",
    "dev:web": "npm run dev --workspace @cipherkeep/web",
    "build:web": "npm run build --workspace @cipherkeep/web",
    "app:build": "cd go/app && wails build",
    "app:dev": "cd go/app && wails dev",
    "app:package": "node scripts/package-app.mjs",
    "app:smoke": "node scripts/smoke-app.mjs",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.64.1",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.0",
    "adm-zip": "^0.6.1",
    "axe-core": "^4.14.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^3.2.4"
  }
}
