        "importRef": "starter:commands:kill",
        "links": [],
        "mastery": 0,
        "name": "kill",
        "notes": "Try plain kill first; -9 skips cleanup and can leave locks or half-written files. Use pkill name or killall name to match by name.",
        "options": [
          {
            "flag": "-l",
            "meaning": "list signal names"
          },
          {
            "flag": "-9",
            "meaning": "SIGKILL: stop immediately; the process cannot clean up"
          },
          {
            "flag": "-15",
            "meaning": "SIGTERM: ask politely (the default)"
          },
          {
            "flag": "-HUP",
            "meaning": "hang up: many daemons reload their config"
          }
        ],
        "placeholders": [],
